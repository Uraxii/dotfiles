# kb.env -- kb-serve config + secrets, machine-local, NEVER committed.
#
# Real location: ~/.knowledgebase/kb.env (gitignored; see .gitignore's
# "Knowledgebase vault" section). Copy this file there and edit it:
#
#   cp ~/dotfiles/scripts/kb-container/kb.env.example ~/.knowledgebase/kb.env
#   chmod 600 ~/.knowledgebase/kb.env
#
# Every value below is optional; kb-serve.py's defaults (see its module
# docstring) apply to anything left unset. The deterministic put/clip/
# query/atomize path never reads any of this -- it only matters for the
# /enrich endpoint.

# Master switch for the LLM enrichment pass. 0 = /enrich is a clean
# no-op (zero network calls). Must be 1 to spend any model calls.
KB_ENRICH=0

# Any OpenAI-compatible chat/completions endpoint. OpenRouter is the
# default because it fronts many providers/models behind one API.
KB_LLM_BASE_URL=https://openrouter.ai/api/v1

# Any model string your KB_LLM_BASE_URL provider accepts.
KB_LLM_MODEL=openai/gpt-4o-mini

# --- API key: pick ONE of the two modes below -----------------------
#
# Mode 1: static value (simplest, least secure -- sits in this file).
# KB_LLM_API_KEY=sk-or-v1-REPLACE_ME
#
# Mode 2: vault command (preferred). kb-serve.py runs this exact command
# through a shell and uses its stdout as the key; wins over
# KB_LLM_API_KEY if both are set. Works with any vault CLI -- e.g.
# `pass show <item>`, `op read op://<vault>/<item>/api-key`,
# `gopass show <item>`.
#
# The command inherits kb-serve.py's process environment, so name your
# vault through an environment variable you export instead of hardcoding
# it here. Export that variable where kb-serve runs (the quadlet's
# Environment=, or your shell); setting it in this file alone does NOT
# reach the command -- it expands to empty, silently.
# KB_LLM_API_KEY_CMD="pass show $VAULT/<item>"
