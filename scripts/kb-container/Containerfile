FROM python:3.13-slim

# kb-serve.py itself is stdlib-only (http.server, sqlite3, urllib,
# importlib -- see its module docstring). Its /clip endpoint reuses
# kb-clip.py verbatim (existing script, not rewritten, per this project's
# reuse-don't-rewrite rule), which already depends on lxml +
# readability-lxml for deterministic web-source extraction. Those are the
# only two pip installs here: pre-existing project dependencies, not new
# ones introduced by this container.
RUN pip install --no-cache-dir lxml readability-lxml

# Flat layout: kb-serve.py locates its sibling scripts (kb-index.py,
# kb-clip.py, kb-atomize.py) via Path(__file__).resolve().parent, which
# only requires them to sit next to it -- no repo-relative path math
# needed, unlike artifact-serve/review-serve's nested COPY.
WORKDIR /app
COPY kb-serve.py kb-atomize.py kb-index.py kb-clip.py ./

EXPOSE 9100

# Foreground, no fork/pidfile (see the `run` verb in kb-serve.py). The
# container runtime is the process supervisor. KB_SERVE_HOST is read by
# kb-serve.py's own --host default (env KB_SERVE_HOST, else 127.0.0.1);
# the quadlet sets it to 0.0.0.0 so Podman's PublishPort= NAT path can
# reach it -- see kb-serve.container's comment for why a literal
# 127.0.0.1 bind inside the container is unreachable from the host.
ENTRYPOINT ["python3", "/app/kb-serve.py", "run", "--port", "9100"]
