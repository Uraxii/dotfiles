*.local
__pycache__/
*.pyc
*.pyo
.pytest_cache/
# uv-managed virtualenv — regenerated by `uv sync`. uv.lock IS tracked.
.venv/
# zsh completion cache — regenerated on shell startup, machine-specific
zsh/.zcompdump*
# xonsh built-in drop-in dir, ~/.config/xonsh is a folded stow symlink into
# this repo, so rc.d files land physically inside xonsh/rc.d/, keep untracked.
xonsh/rc.d/
.claude/*local*
.claude/**/*local*
.claude/settings.json
# .stow-local-ignore is stow's package-level ignore file — DO track it.
!.claude/.stow-local-ignore
configstore
uv
messages.md

# tpm-installed tmux plugins — runtime install, never tracked
tmux/plugins/

.claude/plans
.claude/projects
# claude-code runtime state (written into ~/.claude/ at runtime; never tracked)
.claude/.credentials.json
.claude/cache/
.claude/debug/
.claude/history.jsonl
.claude/plugins/
.claude/session-env/
.claude/statsig/
.claude/todos/
.claude/backups/
.claude/file-history/
.claude/sessions/
.claude/shell-snapshots/
.claude/mcp-needs-auth-cache.json
# Ignore .pipeline/ runtime dirs but keep _shared/ SSoT source tracked
.pipeline/runs/
.pipeline/dreams/
.pipeline/memory/
# Catch any other .pipeline/ children that aren't explicitly tracked
.pipeline/*
!/.pipeline/_shared/
!/.pipeline/_shared/**

# graphify generated knowledge-graph output (not source)
graphify-out/

# Scratch / build artifacts (never tracked)
copilot.zip
tmp/
zsh/.zcompdump

# spikes are untracked wholesale (kept on disk, never committed)
spikes/

# bdui container build dep, regenerated by `npm ci` — never tracked
scripts/bdui-container/node_modules/

# Per-project agent workspace (scripts/init-agent-workspace.sh): the bd
# board and its Dolt runtime state, plus the generated FTS5 KB index, are
# local/regenerable. docs/kb/ (distilled entries) and workstreams/ (status
# files) stay tracked.
.beads/
kb.db

# kb-serve secrets. The real vault lives at ~/.knowledgebase/kb.env,
# entirely outside this repo tree; this guards against an accidental copy
# ever landing inside the repo (e.g. while testing the container build).
# The tracked kb.env.example next to it carries placeholders only.
kb.env
!kb.env.example

# n8n secrets. The real config lives at ~/.local/share/n8n/n8n.env, beside
# the n8n sqlite DB and entirely outside this repo tree; this guards
# against an accidental copy ever landing inside the repo (e.g. while
# testing the container). The tracked n8n.env.example carries placeholders.
n8n.env
!n8n.env.example
.claudex-worktrees/

# Artifact review backend local artifacts
apps/artifact-review/backend/.venv/
**/__pycache__/
*.egg-info/
db.sqlite3
*.sqlite3
