#!/usr/bin/env python
#MISE description="Full machine setup: mise tools, then system packages, then link dotfiles"
import subprocess
import sys
from pathlib import Path

LIB = Path(__file__).resolve().parent.parent / "lib"
REPO = LIB.parent.parent
sys.path.insert(0, str(LIB))
from dotplat import cli

args = cli.parse(sys.argv[1:], "Full machine setup.")
ctx = cli.make_ctx(args)


def run(argv: list[str]) -> None:
    print(f"+ {' '.join(argv)}", flush=True)
    if not ctx.dry_run:
        subprocess.run(argv, check=True)


# Termux installs the user tools with pkg instead (see platforms/termux.py).
if ctx.platform != "termux":
    run(["mise", "install"])

rc = cli.system(sys.argv[1:])

if ctx.platform == "windows":
    print("Windows: no stow. mise reads this repo through MISE_CONFIG_DIR.")
else:
    run(["bash", str(REPO / "setup.sh")])

sys.exit(rc)
