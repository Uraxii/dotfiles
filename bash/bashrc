# Bash config (deployed to ~/.config/bash/bashrc via ~/.bashrc stub).

# mise.run installs mise to ~/.local/bin; zsh and fish add it the same way.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac

# mise: puts the [tools] of ~/.config/mise/config.toml on PATH.
# Termux and NixOS: python and node come from the system, not mise
# (see SYSTEM_RUNTIMES in mise/lib/dotplat/detect.py).
if [ -n "${TERMUX_VERSION:-}" ] || [ -e /etc/NIXOS ]; then export MISE_DISABLE_TOOLS=python,node; fi
command -v mise >/dev/null && eval "$(mise activate bash)"

[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/bash/bashrc.local" ] && \
    . "${XDG_CONFIG_HOME:-$HOME/.config}/bash/bashrc.local"
