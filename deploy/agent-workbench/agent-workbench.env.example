# agent-workbench.env -- OPTIONAL data-root overrides for this bundle.
# No secrets live here (nothing here is sensitive). Copy, edit, then
# `. agent-workbench.env` before running `agent-workbench up`, or just
# export the variables you want to change yourself. Every value below
# defaults to the current live path if left unset.

# Knowledgebase vault (also read directly by kb-serve.py / kb-index.py).
KB_HOME=$HOME/.knowledgebase

# review-serve's feedback DB + uploads. Not yet read by review-serve.py
# itself (its FEEDBACK_ROOT is currently hardcoded); reserved for a future
# relocation track.
ARTIFACTS_HOME=$HOME/.local/share/claude-artifacts

# bd (beads) board hub. Also read directly by scripts/beads-hub.sh.
BEADS_HUB_DIR=$HOME/.beads-hub

# kb-serve's own secrets (LLM enrichment) are NOT here -- see
# scripts/kb-container/kb.env.example and copy it to
# $KB_HOME/kb.env instead.
