#!/bin/sh
# agent-workbench -- one-command local deploy for the agent-workbench
# platform (kb-serve + review-serve containers, bd hub). Reuses the
# existing container definitions verbatim (scripts/kb-container/,
# .claude/skills/artifact-serve/container/) -- this script only builds,
# installs the quadlets, and wires them up; it never rewrites them.
#
# Usage:
#   agent-workbench up      build images, install quadlets, start services
#   agent-workbench down    stop + disable the units this bundle installed
#   agent-workbench status  systemctl status + health checks for both
#
# review-serve may already be running as a hand-installed user unit before
# this bundle ever runs. `up` never restarts or replaces an active
# review-serve; `down` DOES stop it (documented below) -- running `down` at
# all is the operator's opt-in to that.
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DOTFILES_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)

KB_CONTEXT_DIR="$DOTFILES_ROOT/scripts"
KB_CONTAINERFILE="$DOTFILES_ROOT/scripts/kb-container/Containerfile"
KB_QUADLET_SRC="$DOTFILES_ROOT/scripts/kb-container/kb-serve.container"

REVIEW_CONTEXT_DIR="$DOTFILES_ROOT/.claude/skills/artifact-serve"
REVIEW_CONTAINERFILE="$DOTFILES_ROOT/.claude/skills/artifact-serve/container/Containerfile"
REVIEW_QUADLET_SRC="$DOTFILES_ROOT/.claude/skills/artifact-serve/container/review-serve.container"

QUADLET_DIR="$HOME/.config/containers/systemd"

# Data-root overrides. Defaults = the current live paths. The two quadlets
# themselves stay untouched (their own paths are hardcoded via %h -- out of
# scope here, a separate track relocates those); these vars only govern
# what THIS script creates/reports.
KB_HOME="${KB_HOME:-$HOME/.knowledgebase}"
ARTIFACTS_HOME="${ARTIFACTS_HOME:-$HOME/.local/share/claude-artifacts}"
BEADS_HUB_DIR="${BEADS_HUB_DIR:-$HOME/.beads-hub}"

KB_HEALTH_URL="http://127.0.0.1:9100/health"
REVIEW_HEALTH_URL="http://127.0.0.1:9099/"
HEALTH_WAIT_TRIES=15

log() {
    echo "agent-workbench: $*"
}

unit_active() {
    systemctl --user is-active --quiet "$1"
}

build_image() {
    tag="$1" containerfile="$2" context_dir="$3"
    log "building $tag"
    podman build -t "$tag" -f "$containerfile" "$context_dir"
}

# Symlink a tracked quadlet into the live quadlet dir so future edits to
# the source propagate without a re-copy step. Skips entirely if the unit
# is already active -- a running service is never touched.
install_quadlet() {
    unit_name="$1" src="$2"
    if unit_active "$unit_name.service"; then
        log "$unit_name.service active, leaving its installed quadlet untouched"
        return 0
    fi
    mkdir -p "$QUADLET_DIR"
    target="$QUADLET_DIR/$unit_name.container"
    if [ -L "$target" ] && [ "$(readlink -f "$target")" = "$(readlink -f "$src")" ]; then
        return 0
    fi
    ln -sf "$src" "$target"
    log "linked $target -> $src"
}

# Remove a quadlet symlink this bundle installed. Never touches a real
# (non-symlink) file -- e.g. review-serve's hand-installed copy stays put.
uninstall_quadlet() {
    unit_name="$1" src="$2"
    target="$QUADLET_DIR/$unit_name.container"
    if [ -L "$target" ] && [ "$(readlink -f "$target")" = "$(readlink -f "$src")" ]; then
        rm -f "$target"
        log "removed $target"
    fi
}

wait_for_http() {
    url="$1" tries=0
    while [ "$tries" -lt "$HEALTH_WAIT_TRIES" ]; do
        [ "$(http_status "$url")" = "200" ] && return 0
        tries=$((tries + 1))
        sleep 1
    done
    return 1
}

# curl's -w format prints regardless of outcome (e.g. "000" on a refused
# connect), so its own stdout is already the answer -- just neutralize its
# exit status with `|| true` so `set -e` doesn't abort the whole script on
# an expected "service not up yet" connection failure.
http_status() {
    curl -s -o /dev/null -w '%{http_code}' "$1" 2>/dev/null || true
}

cmd_up() {
    mkdir -p "$KB_HOME" "$ARTIFACTS_HOME"

    build_image localhost/kb-serve:latest "$KB_CONTAINERFILE" "$KB_CONTEXT_DIR"
    build_image localhost/review-serve:latest "$REVIEW_CONTAINERFILE" "$REVIEW_CONTEXT_DIR"

    install_quadlet kb-serve "$KB_QUADLET_SRC"
    install_quadlet review-serve "$REVIEW_QUADLET_SRC"
    systemctl --user daemon-reload

    systemctl --user start kb-serve
    log "waiting for kb-serve health..."
    if wait_for_http "$KB_HEALTH_URL"; then
        log "kb-serve up at $KB_HEALTH_URL"
    else
        log "kb-serve not healthy yet -- check: journalctl --user -u kb-serve"
    fi

    if unit_active review-serve.service; then
        log "review-serve already active, leaving it running"
    else
        systemctl --user start review-serve
        log "waiting for review-serve health..."
        if wait_for_http "$REVIEW_HEALTH_URL"; then
            log "review-serve up at $REVIEW_HEALTH_URL"
        else
            log "review-serve not healthy yet -- check: journalctl --user -u review-serve"
        fi
    fi

    if [ -d "$BEADS_HUB_DIR" ]; then
        log "bd hub present at $BEADS_HUB_DIR"
    else
        log "bd hub not found at $BEADS_HUB_DIR -- not a service, created on demand by scripts/beads-hub.sh"
    fi
}

cmd_down() {
    log "stopping review-serve -- this interrupts the shared review app; re-run 'up' or 'systemctl --user start review-serve' to bring it back"
    systemctl --user stop review-serve 2>/dev/null || true
    systemctl --user disable review-serve 2>/dev/null || true
    uninstall_quadlet review-serve "$REVIEW_QUADLET_SRC"

    systemctl --user stop kb-serve 2>/dev/null || true
    systemctl --user disable kb-serve 2>/dev/null || true
    uninstall_quadlet kb-serve "$KB_QUADLET_SRC"

    systemctl --user daemon-reload
}

health_line() {
    code=$(http_status "$1")
    if [ "$code" = "200" ]; then
        echo "health: $code"
    else
        echo "health: unreachable (got $code)"
    fi
}

cmd_status() {
    echo "--- kb-serve ---"
    systemctl --user status kb-serve --no-pager 2>&1 || true
    health_line "$KB_HEALTH_URL"
    echo
    echo "--- review-serve ---"
    systemctl --user status review-serve --no-pager 2>&1 || true
    health_line "$REVIEW_HEALTH_URL"
    echo
    echo "--- bd hub (not a service) ---"
    if [ -d "$BEADS_HUB_DIR" ]; then
        echo "data: $BEADS_HUB_DIR (present)"
    else
        echo "data: $BEADS_HUB_DIR (absent)"
    fi
}

case "${1:-}" in
    up) cmd_up ;;
    down) cmd_down ;;
    status) cmd_status ;;
    *)
        echo "usage: agent-workbench {up|down|status}" >&2
        exit 2
        ;;
esac
